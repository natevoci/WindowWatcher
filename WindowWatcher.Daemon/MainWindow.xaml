<Window x:Class="WindowWatcher.Daemon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:WindowWatcher.Daemon"
        mc:Ignorable="d"
        Title="Window Watcher" Height="0" Width="0"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        Visibility="Hidden"
        Closing="Window_Closing">
    
    <Window.Resources>
        <ContextMenu x:Key="TrayContextMenu">
            <MenuItem Header="View Events" FontWeight="Bold" Click="ViewEventsMenuItem_Click"/>
            <MenuItem Header="View Analyser" Click="ViewAnalyserMenuItem_Click"/>
            <MenuItem Header="View Screenshots" Click="ViewScreenshotsMenuItem_Click"/>
            <MenuItem x:Name="CaptureToggleMenuItem" Header="Stop Capture" Click="CaptureToggleMenuItem_Click"/>

            <Separator/>

            <MenuItem Header="Settings..." Click="SettingsMenuItem_Click"/>

            <Separator/>

            <MenuItem Header="Exit" Click="ExitMenuItem_Click"/>
        </ContextMenu>
    </Window.Resources>
    
    <Grid>
        <tb:TaskbarIcon x:Name="TrayIcon"
                        IconSource="Icon1.ico"
                        ToolTipText="Window Watcher"
                        ContextMenu="{StaticResource TrayContextMenu}"
                        TrayMouseDoubleClick="TrayIcon_TrayMouseDoubleClick"/>
    </Grid>
</Window>
