{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: publish daemon",
      "type": "shell",
      "command": "dotnet publish WindowWatcher.Daemon/WindowWatcher.Daemon.csproj --self-contained -r win-x64 -o publish/WindowWatcher",
      "group": "build"
    },
    {
      "label": "build: publish analyser",
      "type": "shell",
      "command": "dotnet publish WindowWatcher.Analyser/WindowWatcher.Analyser.csproj --self-contained -r win-x64 -o publish/WindowWatcher",
      "group": "build"
    },
    {
      "label": "build: publish viewer",
      "type": "shell",
      "command": "dotnet publish WindowWatcher.ScreenshotViewer/WindowWatcher.ScreenshotViewer.csproj --self-contained -r win-x64 -o publish/WindowWatcher",
      "group": "build"
    },
    {
      "label": "build: publish all",
      "group": "build",
      "dependsOn": [
        "build: publish daemon",
        "build: publish analyser",
        "build: publish viewer"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "install velopack",
      "type": "shell",
      "command": "dotnet tool install --global vpk",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "build: installer",
      "type": "shell",
      "command": "vpk pack --packId WindowWatcher --packVersion 2.0.0 --packDir publish/WindowWatcher --mainExe WindowWatcher.Daemon.exe --yes --skip-updates",
      "group": "build",
      "dependsOn": [
        "build: publish all"
      ]
    },
    {
      "label": "run: Daemon",
      "type": "shell",
      "command": "dotnet run --project WindowWatcher.Daemon/WindowWatcher.Daemon.csproj",
      "problemMatcher": []
    },
    {
      "label": "run: Analyser",
      "type": "shell",
      "command": "dotnet run --project WindowWatcher.Analyser/WindowWatcher.Analyser.csproj",
      "problemMatcher": []
    },
    {
      "label": "run: ScreenshotViewer",
      "type": "shell",
      "command": "dotnet run --project WindowWatcher.ScreenshotViewer/WindowWatcher.ScreenshotViewer.csproj",
      "problemMatcher": []
    }
  ]
}
